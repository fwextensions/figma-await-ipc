{
  "name": "figma-await-ipc",
  "version": "0.1.0",
  "description": "A simple await-able replacement for postMessage() in Figma plugins.",
  "keywords": [
    "figma",
    "plugin",
    "await",
    "promise",
    "postMessage"
  ],
  "author": "John Dunning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwextensions/figma-await-ipc.git"
  },
  "bugs": {
    "url": "https://github.com/fwextensions/figma-await-ipc/issues"
  },
  "homepage": "https://github.com/fwextensions/figma-await-ipc#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "npm run build -- --watch",
    "prepack": "npm run build",
    "release": "dotenv release-it",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "dotenv-cli": "^11.1.0",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "npm run typecheck",
        "npm test"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Added"
            },
            {
              "type": "fix",
              "section": "Fixes"
            },
            {
              "type": "chore",
              "section": "Chores"
            },
            {
              "type": "ci",
              "section": "CI/CD"
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog",
        "ignoreRecommendedBump": true
      }
    }
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  },
  "tsdown": {
    "entry": "src/index.ts",
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "sourcemap": true,
    "fixedExtension": false,
    "target": "es2020"
  }
}
